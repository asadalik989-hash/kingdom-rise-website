    },
    "/tender_submissions/{tenderId}": {
      "schema": { "$ref": "#/entities/TenderSubmission" },
      "description": "Formal bidding prequalification dossiers"
    },
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaItem" },
      "description": "Asset library registry"
    },
    "/website_settings/{settingId}": {
      "schema": { "$ref": "#/entities/WebsiteSettings" },
      "description": "Dynamic website configuration variables"
    },
    "/social_links/{linkId}": {
      "schema": { "$ref": "#/entities/SocialLink" },
