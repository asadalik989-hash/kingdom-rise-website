  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Registered administrator accounts and role privileges"
    },
    "/archived_administrators/{archiveId}": {
      "schema": { "type": "object" },
      "description": "Safely archived deleted administrator records and audit traces"
    },
    "/project_categories/{catId}": {
      "schema": { "$ref": "#/entities/ProjectCategory" },
      "description": "Engineering categories for portfolio grouping"
    },
    "/projects/{projectId}": {
