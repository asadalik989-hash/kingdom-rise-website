        "internalNotes": { "type": "string" },
        "assignedAdmin": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "companyName", "email", "phone", "projectType", "projectLocation", "scopeDescription", "status", "createdAt"]
    },
    "TenderSubmission": {
      "title": "TenderSubmission",
      "description": "Formal bidding prequalification dossier and commercial proposal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "crNumber": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "projectSector": { "type": "string" },
        "proposedValue": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["SUBMITTED", "UNDER_REVIEW", "PREQUALIFIED", "SHORTLISTED", "REJECTED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyName", "crNumber", "contactPerson", "email", "phone", "projectSector", "status", "createdAt"]
    },
