    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Inbound public contact form message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["New", "Read", "In Progress", "Resolved", "Archived"] },
        "internalNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "phone", "subject", "message", "status", "createdAt"]
    },
    "QuoteRequest": {
      "title": "QuoteRequest",
      "description": "Inbound tender quotation and scope proposal request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "companyName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "projectType": { "type": "string" },
        "projectLocation": { "type": "string" },
        "estimatedBudget": { "type": "string" },
        "timeline": { "type": "string" },
