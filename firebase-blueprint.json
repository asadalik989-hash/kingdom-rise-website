{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator or editor account profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "Corporate email address" },
        "displayName": { "type": "string", "description": "Full legal or display name" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "EDITOR"], "description": "Role-based access level" },
        "status": { "type": "string", "enum": ["active", "suspended"], "description": "Account authorization status" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation ISO timestamp" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Last authenticated ISO timestamp" }
      },
      "required": ["id", "email", "displayName", "role", "status", "createdAt"]
    },
    "ProjectCategory": {
      "title": "ProjectCategory",
      "description": "Classification category for engineering and construction projects",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique category identifier" },
        "name": { "type": "string", "description": "Category name" },
        "slug": { "type": "string", "description": "URL-friendly slug" },
        "description": { "type": "string", "description": "Brief description" },
        "sector": { "type": "string", "enum": ["Civil", "Electrical", "Mechanical", "Oil & Gas", "Water & Power", "Aviation", "Industrial"], "description": "Primary industry sector" },
        "displayOrder": { "type": "number", "description": "Sorting index" },
        "isActive": { "type": "boolean", "description": "Whether active" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "sector", "displayOrder", "isActive", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Verified construction and infrastructure contract record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique project identifier" },
        "title": { "type": "string", "description": "Project title" },
        "slug": { "type": "string", "description": "URL slug" },
        "client": { "type": "string", "description": "Client or contracting authority" },
        "year": { "type": "string", "description": "Execution or delivery year" },
        "era": { "type": "string", "enum": ["2002-2008", "2009-2015", "2016-2020", "2021-2023+"], "description": "Chronological operational epoch" },
        "sector": { "type": "string", "enum": ["Civil", "Electrical", "Mechanical", "Oil & Gas", "Water & Power", "Aviation", "Industrial"] },
        "categoryId": { "type": "string", "description": "Foreign key reference to ProjectCategory" },
        "category": { "type": "string", "description": "Human readable category label" },
        "location": { "type": "string", "description": "Site municipality in Saudi Arabia" },
        "status": { "type": "string", "enum": ["Planning", "Ongoing", "Completed", "Archived"] },
        "description": { "type": "string", "description": "Technical narrative and project overview" },
        "scope": { "type": "array", "description": "Key contractual deliverables" },
        "features": { "type": "array", "description": "Engineering highlights" },
        "featuredImage": { "type": "string", "description": "Primary thumbnail asset URL" },
        "galleryImages": { "type": "array", "description": "Image gallery assets" },
        "isPublished": { "type": "boolean", "description": "Public catalog visibility" },
        "completionDate": { "type": "string", "description": "Handover completion date" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "client", "year", "era", "sector", "category", "location", "status", "isPublished", "createdAt"]
    },
    "ServiceCategory": {
      "title": "ServiceCategory",
      "description": "Division category grouping for core technical capabilities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "divisionNumber": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "displayOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "divisionNumber", "name", "slug", "displayOrder", "isActive", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "description": "Contractor engineering division capability offering",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "divisionNumber": { "type": "string" },
        "categoryId": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "shortDesc": { "type": "string" },
        "fullDesc": { "type": "string" },
        "capabilities": { "type": "array" },
        "teamComposition": { "type": "array" },
        "keyHighlights": { "type": "array" },
        "image": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "divisionNumber", "title", "slug", "shortDesc", "fullDesc", "isPublished", "createdAt"]
    },
    "BlogCategory": {
      "title": "BlogCategory",
      "description": "Taxonomy category for technical articles and news",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "displayOrder", "createdAt"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Technical insights article or company press release",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "categoryId": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "readTime": { "type": "string" },
        "author": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "array" },
        "tags": { "type": "array" },
        "status": { "type": "string", "enum": ["Draft", "Published", "Scheduled", "Archived"] },
        "featuredImage": { "type": "string" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "ogImage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "category", "author", "summary", "status", "createdAt"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Verified client endorsement and project reference",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "company": { "type": "string" },
        "position": { "type": "string" },
        "testimonialText": { "type": "string" },
        "profileImage": { "type": "string" },
        "projectId": { "type": "string" },
        "displayOrder": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "clientName", "company", "testimonialText", "isPublished", "createdAt"]
    },
    "TeamMember": {
      "title": "TeamMember",
